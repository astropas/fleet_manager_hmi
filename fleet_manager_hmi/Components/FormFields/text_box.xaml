<UserControl x:Class="fleet_manager_hmi.Components.FormFields.text_box"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:fleet_manager_hmi.Components.FormFields"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="box_round_borders" TargetType="Control" 
                   BasedOn="{StaticResource body_large-regular}">
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Style.Resources>
                <Setter Property="Padding" Value="10,0,0,0"/>
                <Setter Property="Background" Value="{StaticResource gray_50}"/>
                <Setter Property="Foreground" Value="{StaticResource gray_600}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>

            <Style x:Key="box_label" TargetType="Control" 
                   BasedOn="{StaticResource body_medium-medium}">
                <Setter Property="Foreground" Value="{StaticResource gray_500}"/>
                <Setter Property="Padding" Value="13,0,0,0"/>
            </Style>

            <Style x:Key="box_error_status" TargetType="Control" 
                   BasedOn="{StaticResource body_large-light}">
                <Setter Property="Foreground" Value="{StaticResource supporting_red_600}"/>
            </Style>

            <Style x:Key="box_good_status" TargetType="Control" 
                   BasedOn="{StaticResource body_large-light}">
                <Setter Property="Foreground" Value="{StaticResource supporting_green_600}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" d:Content="Title goes here"
               Content="{Binding Title}"
               Style="{StaticResource box_label}"
               Target="{Binding ElementName=InTextBox}"/>

        <TextBox Grid.Row="1" Name="InTextBox" d:Text="Text goes here"
                   Text="{Binding InputText}"
                   Style="{StaticResource box_round_borders}"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Label Style="{StaticResource box_error_status}" d:Content="Fail"
                   Content="{Binding MexFail}"/>

            <Label Style="{StaticResource box_good_status}" d:Content="Good"
                   Content="{Binding MexOk}"/>
        </StackPanel>
    </Grid>
</UserControl>
